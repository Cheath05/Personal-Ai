# Copy to .env in the repo root. Never commit .env.

# Your first name, used by the agents.
CARDINAL_USER_NAME=Alex
CARDINAL_TIMEZONE=America/New_York

# Optional: Claude as a capped backup. Leave empty to run fully local.
# Create a key at console.anthropic.com (prepaid credit, auto-reload off, $20 monthly limit).
ANTHROPIC_API_KEY=

# Monthly Claude budget. At the soft cap only essential jobs use Claude; at the hard cap everything runs locally.
CARDINAL_BUDGET_SOFT_USD=15
CARDINAL_BUDGET_CAP_USD=20
