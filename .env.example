# Copy to .env in the repo root. Never commit .env.

# Your first name, used by the agents.
CARDINAL_USER_NAME=Alex
CARDINAL_TIMEZONE=America/New_York

# Optional: Claude as a capped backup. Leave empty to run fully local.
# Create a key at console.anthropic.com (prepaid credit, auto-reload off, $20 monthly limit).
ANTHROPIC_API_KEY=

# Monthly Claude budget. At the soft cap only essential jobs use Claude; at the hard cap everything runs locally.
CARDINAL_BUDGET_SOFT_USD=15
CARDINAL_BUDGET_CAP_USD=20

# Where people open Cardinal (the hub's Tailscale address). Google sends you back here after sign-in.
CARDINAL_PUBLIC_URL=http://localhost:8000

# Phase 2: Google Calendar + Gmail (read-only for now). From your Google Cloud OAuth client.
# On the hub, set these with infra/set-secret.sh so they never pass through chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Blackboard: Calendar -> settings -> "Get external calendar link". Anyone with it can see your due dates.
CARDINAL_BLACKBOARD_ICS_URL=

# Ordinal's morning briefing, local time.
CARDINAL_BRIEFING_TIME=06:00
